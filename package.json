{
  "name": "myworkout",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build:web": "expo export --platform web && node scripts/offline-web.mjs",
    "test:e2e": "playwright test",
    "test:db": "node --test tests/database.test.mjs",
    "test:cloud": "node scripts/cloud-proof.mjs",
    "format": "prettier --write app src tests e2e scripts *.json *.ts *.cjs .github/workflows/ci.yml",
    "test:offline": "node --test tests/offline.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
